# Keep the build context small and free of host state. Anything the image needs is copied
# explicitly in the Dockerfile.

# Build output and caches — the image builds these itself
build/
.gradle/
# node_modules holds host-platform binaries; the image runs `npm ci` for its own. Keeping it out
# of the context also keeps the context small enough for the build to stay fast.
node_modules/
mcp-server/dist/

# Application data — never goes into an image
data/
*.db
*.db-shm
*.db-wal

# Version control and project docs
.git/
.gitignore
vault/
CLAUDE.md
README.md

# Container files themselves
Dockerfile
.dockerignore
compose.yaml
Makefile

# IDE and OS cruft
.idea/
.vscode/
*.iml
.DS_Store
